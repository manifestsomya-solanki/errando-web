# Environment — erranddo-web (customer + pro app)
# Backend: erranddo-node only (delete old erranddo-api Laravel folder safely)

VITE_NODE_ENV=development

VITE_API_BASE_URL_DEVELOPMENT=http://127.0.0.1:8000/api/v1
VITE_API_BASE_URL_PRODUCTION=https://api.erranddo.com/api/v1
