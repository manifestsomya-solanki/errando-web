# Environment Configuration
# Set to: development, production, or staging
VITE_NODE_ENV= development

# API Base URLs
VITE_API_BASE_URL_DEVELOPMENT=http://127.0.0.1:8000/api/v1
VITE_API_BASE_URL_PRODUCTION=https://erranddo.com/admin/api/v1
VITE_API_BASE_URL_STAGING=https://staging.erranddo.com/admin/api/v1

# Forgot Password URL (special case)
VITE_FORGOT_PASSWORD_URL=http://127.0.0.1:8001/api/v1/forgot-password
# Stripe Configuration (leave empty to disable Stripe)
VITE_STRIPE_PUBLISHABLE_KEY=
